# منفذ الخادم
PORT=3000
# حساب المدير الأول (يُنشأ تلقائيًا عند أول تشغيل إن لم يوجد مستخدمون).
# إن تركتهما فارغين ستظهر شاشة إعداد في المتصفح لإنشاء المدير.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# مجلد حفظ الجلسات والرسائل
DATA_DIR=./data
# لحسابات Meta Cloud API فقط: توكن التحقق من الـ Webhook + App Secret للتحقق من توقيع الطلبات
META_VERIFY_TOKEN=
META_APP_SECRET=
# مفتاح الدولة الافتراضي لتوحيد الأرقام المحلية (يمكن تغييره من الإعدادات)
DEFAULT_COUNTRY_CODE=966
# اجعله true عند التشغيل خلف HTTPS فقط
COOKIE_SECURE=false
META_API_VERSION=v21.0

# ---------- Cloudflare Tunnel (للتشغيل على جهاز محلي) ----------
# التوكن من Cloudflare Zero Trust ← Networks ← Tunnels ← Create a tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- تنبيهات الاستفسارات (الدورات/الشهادات) ----------
# الإيميل الذي تصلك عليه التنبيهات (يمكن تغييره من الواجهة)
ALERT_EMAIL=

# SMTP لإرسال التنبيهات. مثال Gmail: smtp.gmail.com + كلمة مرور تطبيق (App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# IMAP لمراقبة صندوق البريد الوارد والتقاط استفسارات الإيميل. مثال Gmail: imap.gmail.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
