# منفذ الخادم
PORT=3000
# كلمة مرور لوحة التحكم (اتركها فارغة لتعطيل الحماية - غير مستحسن عند النشر)
ADMIN_PASSWORD=
# مجلد حفظ الجلسات والرسائل
DATA_DIR=./data
# لحسابات Meta Cloud API فقط: توكن التحقق من الـ Webhook
META_VERIFY_TOKEN=
META_API_VERSION=v21.0

# ---------- تنبيهات الاستفسارات (الدورات/الشهادات) ----------
# الإيميل الذي تصلك عليه التنبيهات (يمكن تغييره من الواجهة)
ALERT_EMAIL=

# SMTP لإرسال التنبيهات. مثال Gmail: smtp.gmail.com + كلمة مرور تطبيق (App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# IMAP لمراقبة صندوق البريد الوارد والتقاط استفسارات الإيميل. مثال Gmail: imap.gmail.com
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
